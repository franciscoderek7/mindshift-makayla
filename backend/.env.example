# ============================================
# MindShift Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# ============================================

# --- Application ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Authentication ---
JWT_SECRET=your-jwt-secret-here-min-32-chars
SESSION_SECRET=your-session-secret-here-min-32-chars

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://localhost:5432/mindshift_dev

# --- Cache & Sessions (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Stripe Payments ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Calendly Scheduling ---
CALENDLY_API_KEY=your-calendly-personal-access-token
CALENDLY_WEBHOOK_SECRET=your-calendly-webhook-signing-key
CALENDLY_USER_URI=https://api.calendly.com/users/your-user-id

# --- SendGrid Email ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=makayla@mindshift.ca
SENDGRID_FROM_NAME=MindShift

# --- OpenAI (Agent Reasoning) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# --- Admin ---
ADMIN_EMAIL=makayla@mindshift.ca
ADMIN_PHONE=+17055550199

# --- Logging ---
LOG_LEVEL=info
